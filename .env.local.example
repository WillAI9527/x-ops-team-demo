# 复制为 .env.local 后填写。不要提交到 git，不要发到群里。
ZENMUX_API_KEY=
# 可选：设置后，所有 /api/agents 和 /api/ask 请求都要带 Authorization: Bearer <token>
AGENTS_API_TOKEN=
# 可选
# PORT=8787
# HOST=127.0.0.1        # 要给局域网/网关访问时改成 0.0.0.0
# CORS_ORIGIN=*

# ---- v1.4 对标账号分析（全部可选） ----
# 用 X API v2 抓取对标账号（不填就用「导入 JSON」或示例数据）
X_BEARER_TOKEN=
# 发帖队列自动发帖用（OAuth 1.0a，@LucaAiAi 的应用密钥，需要 Read and Write 权限）。不填 = 只提示「未配置发帖密钥」+ x.com 手动发
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# KB_TOP_PERCENT=20       # 知识库保存热度前百分之多少
# SCHEDULER_INTERVAL=30   # 发帖调度器检查间隔（秒）
# PORT=8788               # start-x-ops.command 默认用 8788

# v1.5：只有当前账号是这个 handle 时才允许自动发帖（防止发错号）
X_POST_HANDLE=LucaAiAi
# 免密抓取的公开接口（一般不用改）
# FX_API_BASE=https://api.fxtwitter.com
